---
const chip =
  'inline-flex items-center gap-1 rounded-lg border border-gray-200 p-1 px-2 text-sm dark:border-gray-700'
---

<ul class="flex flex-wrap gap-2">
  <li>
    <a
      href="https://www.facebook.com/SRBSiravijbb/"
      class:list={[
        chip,
        'bg-white text-gray-600 hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700',
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-auto fill-[#4267B2]"
        viewBox="0 0 50 50"
        aria-hidden="true"
      >
        <path
          d="M40,0H10C4.486,0,0,4.486,0,10v30c0,5.514,4.486,10,10,10h30c5.514,0,10-4.486,10-10V10C50,4.486,45.514,0,40,0z M39,17h-3 c-2.145,0-3,0.504-3,2v3h6l-1,6h-5v20h-7V28h-3v-6h3v-3c0-4.677,1.581-8,7-8c2.902,0,6,1,6,1V17z"
        ></path>
      </svg>
      Facebook
    </a>
  </li>
  <li>
    <span
      class:list={[
        chip,
        'cursor-not-allowed bg-gray-300 text-gray-500 dark:bg-gray-600 dark:text-gray-300',
      ]}
      aria-disabled="true"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        class="h-5 w-auto fill-current"
