        'cursor-not-allowed bg-gray-300 text-gray-500 dark:bg-gray-600 dark:text-gray-300',
      ]}
      aria-disabled="true"
    >
      <svg
        class="h-5 w-auto fill-current"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
