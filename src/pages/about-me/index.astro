---
import Navbar from '../../components/Navbar.astro'
import Layout from '../../components/layout.astro'
import Footer from '../../components/Footer.astro'
import Contact from '../../components/script/Contact.astro'

const pill =
  'inline-flex items-center gap-1 rounded-lg bg-black px-2 py-1 text-white shadow-lg hover:shadow-xl'

const documents = [
  { href: '/SiravijPraevisavakijCV.pdf', label: 'CV' },
  { href: '/YWC20_Portfolio.pdf', label: 'YWC20 Portfolio' },
  { href: '/SIRAVIJP.PORTKMUTT_R1.pdf', label: 'KMUTT Portfolio' },
]
---

<Layout
  title="Biography"
  description="Siravij Praevisavakij biography"
  image="/siravij.webp"
>
  <Navbar />
  <main
    class="mx-auto max-w-7xl rounded-xl shadow-xl md:my-6 dark:bg-[#332940]"
  >
    <div class="instructions">
      <h1 class="text-center text-[1.1rem] md:text-base">
        <span class="text-gradient">Siravij Praevisavakij biography</span>
      </h1>
      <p class="mx-auto text-center text-[0.9rem] md:text-[1.2rem]">
        This website is built by <code>Siravij</code>
      </p>
    </div>

    <div
      class="mx-auto rounded-lg bg-neutral-200 px-2 py-10 md:flex md:gap-4 md:px-8 dark:bg-[#121212]"
    >
      <section
        class="mx-auto flex-none rounded-lg bg-white px-5 pb-4 text-center shadow-xl hover:shadow-2xl md:w-80 dark:bg-[#332940]"
      >
        <h2 class="pt-3 text-2xl md:pt-2 md:text-lg">Siravij Praevisavakij</h2>
        <img
          class="mx-auto"
          src="/siravij.webp"
          width="659"
          height="899"
          alt="Siravij half body"
        />
      </section>

      <section
        class="mt-3 flex-1 rounded-lg bg-white px-4 py-4 text-sm shadow-xl md:mt-0 md:text-xl dark:bg-[#332940]"
      >
        <h2 class="text-center md:text-left">Biography</h2>
        <p class="p-4">
          Siravij the electrical and website engineer nerd, who love to test the
          website speed and design electrical circuit.
        </p>

        <dl class="space-y-5 px-4">
          <div class="flex flex-wrap items-center gap-2">
            <dt>Project :</dt>
            <dd class="flex flex-wrap gap-2">
              <a
                href="https://creatorsgarten.org/"
                aria-label="creatorsgarten Page"
                class={pill}
              >
                <img
                  class="h-5 w-auto"
                  src="/garten.svg"
                  alt=""
                  width="20"
                  height="20"
                />
                creatorsgarten
              </a>
              <a href="https://github.com/KNACKSAT2-TGPS" class={pill}>
                KNACKSAT-2 TGPS
              </a>
            </dd>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <dt>Contact :</dt>
            <dd><Contact /></dd>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <dt>My resume :</dt>
            <dd class="flex flex-wrap gap-2">
              {
                documents.map(({ href, label }) => (
                  <a href={href} class={pill}>
                    {label}
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>
      </section>
    </div>
    <Footer />
  </main>
</Layout>

<style>
  :root {
    --accent: 124, 58, 237;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      #da62c4 30%,
      white 60%
    );
  }
  .text-gradient {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
  }
  .instructions {
    line-height: 1.6;
    margin: 1rem 0;
    border: 1px solid rgba(var(--accent), 25%);
    padding: 1rem;
    border-radius: 0.4rem;
  }
  .instructions code {
    font-size: 0.875em;
    font-weight: bold;
    background: rgba(var(--accent), 12%);
    color: rgb(var(--accent));
    border-radius: 4px;
    padding: 0.3em 0.45em;
  }
</style>
