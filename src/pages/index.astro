---
import Navbar from '../components/Navbar.astro'
import Layout from '../components/layout.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Home"
  description="Siravij's Website"
  image="/Siravij_INTBall-900.webp"
  bodyClass="flex flex-col"
>
  <Navbar />
  <main class="flex flex-1 bg-neutral-500 dark:bg-neutral-800">
    <div
      class="mx-auto grid w-full max-w-7xl items-center gap-8 px-6 py-10 md:grid-cols-2 md:px-10"
    >
      <div
        class="w-fit justify-self-center rounded-xl bg-gray-900 p-4 text-3xl text-white shadow-xl md:justify-self-start md:text-4xl"
      >
        Welcome to<b class="text-[#ab98ff] underline"> Siravij's</b>
        <span class="block text-xl">I'm Siravij Praevisavakij</span>
      </div>

      <img
        src="/Siravij_INTBall-900.webp"
        srcset="/Siravij_INTBall-900.webp 900w, /Siravij_INTBall.webp 4284w"
        sizes="(min-width: 768px) 50vw, 100vw"
        width="900"
        height="1200"
        alt="It's Me, Siravij!"
        fetchpriority="high"
        class="mx-auto h-auto max-h-[75svh] w-auto object-contain"
      />
    </div>
  </main>
  <Footer />
</Layout>
