---
import Navbar from '../components/Navbar.astro'
import Layout from '../components/layout.astro'
import Footer from '../components/Footer.astro'
---

<Layout
  title="Home"
  description="Siravij's Website"
  image="/Siravij_INTBall-900.webp"
  bodyClass="flex flex-col"
>
  <Navbar />
  <main class="flex flex-1 bg-neutral-500 dark:bg-neutral-800">
    <div class="mx-auto flex w-full max-w-7xl items-center justify-center px-6 py-10">
      <div class="relative w-full max-w-[calc(80svh*3/4)]">
        <img
          src="/Siravij_INTBall-900.webp"
          srcset="/Siravij_INTBall-900.webp 900w, /Siravij_INTBall.webp 4284w"
          sizes="(min-width: 768px) 50vw, 100vw"
          width="900"
          height="1200"
          alt="It's Me, Siravij!"
          fetchpriority="high"
          class="h-auto w-full rounded-xl shadow-xl"
        />
        <div
          class="absolute inset-x-4 bottom-4 rounded-xl bg-gray-900/75 p-4 text-2xl text-white shadow-xl backdrop-blur-sm sm:text-3xl md:text-4xl"
        >
          Welcome to<b class="text-[#ab98ff] underline"> Siravij's</b>
          <span class="block text-lg sm:text-xl">I'm Siravij Praevisavakij</span>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
